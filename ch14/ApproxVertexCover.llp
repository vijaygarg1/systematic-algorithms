// 2-approximation vertex cover: greedily pick both endpoints of an uncovered edge.

class ApproxVertexCover {
  boolean[] ApproxVertexCover(int[][] adj) {
    int n = adj.length;
    boolean[] C = new boolean[n];
    boolean[] removed = new boolean[n];
    boolean done = false;
    while (!done) {
      done = true;
      forall u in [0..n-1] : {
        if (!removed[u]) {
          int v = u + 1;
          while (v < n) {
            if (!removed[v] && adj[u][v] == 1) {
              C[u] = true;
              C[v] = true;
              removed[u] = true;
              removed[v] = true;
              done = false;
              v = n;
            } else {
              v = v + 1;
            }
          }
        };
      }
    };
    return C;
  }
}
