// Constrained-Stable-Matching: stable matching with precedence constraints.

class Constrained_Stable_Matching {
  void Constrained_Stable_Matching(int[1..n][1..n] mpref, int[1..n][1..n] rank, int n) {
    int[1..n] G = 0;
    setBase(1);
    always : int z = mpref[j][G[j]]
    forbidden (j) :
      G[j] == 0
      || (exists i in [1..n] : exists k in [1..G[i]] : z == mpref[i][k] && rank[z][i] < rank[z][j])
    =>
      advance : G[j] = G[j] + 1;
  }
}
