// LLP-StableMarriage: Gale-Shapley as a lattice-linear program, written
// exactly as bxx-stableMatching.tex's Algorithm LLP-StableMarriage:

class LLPStableMarriage {
  int[] LLPStableMarriage(int[0..n][0..n] mpref, int[0..n][0..n] rank) {
    setBase(1);
    int[0..n] G = 0;
    int[0..n] partner = 0;
    always : int z = mpref[i][G[i]];
    forbidden (i in [1..n]) :
      G[i] == 0 || (partner[z] != 0 && rank[z][partner[z]] < rank[z][i])
    =>
      advance : {
        G[i] = G[i] + 1;
        z = mpref[i][G[i]];
        if (partner[z] == 0 || rank[z][i] < rank[z][partner[z]]) {
          partner[z] = i;
        };
      };
    return G;
  }
}
