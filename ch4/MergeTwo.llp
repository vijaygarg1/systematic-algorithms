// MergeTwo: merge two sorted arrays into one, matching bxx-sort.tex
// Algorithm MergeTwo (fig:mergetwo) line for line -- including the two
// leftover-copy loops, which the book also prints as a single line each.

class MergeTwo {
  int[] MergeTwo(int[] B, int[] C) {
    int m = B.length, n = C.length;
    int[] D = new int[m + n];
    int i = 0, j = 0, k = 0;
    while (i < m && j < n) {
      if (B[i] <= C[j]) {
        D[k] = B[i];
        i = i + 1;
      } else {
        D[k] = C[j];
        j = j + 1;
      };
      k = k + 1;
    };
    while (i < m) { D[k] = B[i]; i = i + 1; k = k + 1; };   // leftover from B
    while (j < n) { D[k] = C[j]; j = j + 1; k = k + 1; };   // leftover from C
    return D;
  }
}
