// Classical Gale-Shapley man-optimal stable-matching loop.

class GaleShapley {
  int[] match(int[][] mpref, int[][] rank) {
    int n = mpref.length - 1;
    int[] G = new int[n + 1];
    int[] partner = new int[n + 1];
    int[] freeMen = new int[n + 1];
    int top = 0;
    forall i in [1..n] : { freeMen[top] = i; top = top + 1; };

    // Each iteration pops a free man and lets him propose to his next
    // preference. Loop until no free man remains.
    while (top > 0) {
      top = top - 1;
      int i = freeMen[top];
      G[i] = G[i] + 1;
      int z = mpref[i][G[i]];
      if (partner[z] == 0) {
        partner[z] = i;
      } else {
        if (rank[z][i] < rank[z][partner[z]]) {
          // i displaces the current partner, who becomes free.
          freeMen[top] = partner[z];
          top = top + 1;
          partner[z] = i;
        } else {
          // i is rejected and stays free; he tries his next preference.
          freeMen[top] = i;
          top = top + 1;
        }
      }
    };
    return G;
  }
}
