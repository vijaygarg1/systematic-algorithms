// LLP-WeightedVertexCover: primal-dual 2-approximation for weighted
// vertex cover, matching bxx-approximate.tex Algorithm
// LLP-WeightedVertexCover (fig:llp-wvc). The lattice is indexed by EDGES,
// as the book's "G: array[E] of real" and "Forbidden(e)" say: G[e] is the
// price on edge e. A vertex v is tight when its incident prices saturate

class LLPWeightedVertexCover {
  boolean[] LLPWeightedVertexCover(int[] eu, int[] ev, double[] w) {
    int nv = w.length;
    int m = eu.length;
    double[] G = new double[m];
    double[] price = new double[nv];
    int[] minSlackEdge = new int[nv];
    int[] edeg = new int[nv];
    int[] efill = new int[nv];
    int[][] inc = new int[nv][];
    boolean fresh = false;
    forall e in [0..m-1] : {
      edeg[eu[e]] = edeg[eu[e]] + 1;
      edeg[ev[e]] = edeg[ev[e]] + 1;
    };
    forall v in [0..nv-1] : inc[v] = new int[edeg[v]];
    forall e in [0..m-1] : {
      inc[eu[e]][efill[eu[e]]] = e;
      efill[eu[e]] = efill[eu[e]] + 1;
      inc[ev[e]][efill[ev[e]]] = e;
      efill[ev[e]] = efill[ev[e]] + 1;
    };
    forbidden (e in [0..n-1]) : slackMin(e) =>
      advance : {
        double step = min(w[eu[e]] - price[eu[e]], w[ev[e]] - price[ev[e]]);
        G[e] = G[e] + step;
        price[eu[e]] = price[eu[e]] + step;
        price[ev[e]] = price[ev[e]] + step;
        fresh = false;
      };
    boolean[] C = new boolean[nv];
    forall i in [0..nv-1] : C[i] = tight(i);
    return C;
  }

  boolean tight(int v) {
    return price[v] >= w[v];
  }

  // Neither endpoint of e is tight, so e's price can still be raised.
  boolean slack(int e) {
    return !tight(eu[e]) && !tight(ev[e]);
  }

  // Rebuild each vertex's lex-least slack incident edge when a price has
  // moved. Each vertex consults only its own incident edges, so the whole
  // rebuild is O(m).
  void refresh() {
    if (!fresh) {
      forall v in [0..nv-1] : minSlackEdge[v] = firstSlackEdge(v);
      fresh = true;
    }
  }

  // The first slack edge in inc[v], or -1 when v has none. Because the
  // edges are in lex order, "first" is the same as "lex-least".
  int firstSlackEdge(int v) {
    int k = 0;
    while (k < inc[v].length) {
      if (slack(inc[v][k])) { return inc[v][k]; };
      k = k + 1;
    };
    return 0 - 1;
  }

  // e is slack and lex-minimal among the slack edges sharing an endpoint
  // with it -- which holds exactly when it is the lex-least at both ends.
  boolean slackMin(int e) {
    refresh();
    if (!slack(e)) { return false; };
    return minSlackEdge[eu[e]] == e && minSlackEdge[ev[e]] == e;
  }
}
