// Layering, as bxx-graph.tex's Algorithm Layering states it:
//
//   var Q: queue of int                       // initially empty
//   indeg[j] := |pre(j)| for all j
//   forall j in V: if indeg[j] = 0: G[j] := 0; Q.enqueue(j)
//   while not Q.empty():
//     j := Q.dequeue()
//     forall k in succ(j):
//       indeg[k] := indeg[k] - 1
//       if indeg[k] = 0: G[k] := 1 + max_{i in pre(k)} G[i]; Q.enqueue(k)
//   return G
//
// Kahn's algorithm: a vertex gets its layer once every predecessor has
// one. The book's `queue of int` is a list<int> -- add is enqueue,
// removeFirst is dequeue.

class Layering {
  int[] Layering(set<int>[] pre, set<int>[] succ) {
    int n = pre.length;
    int[] G = new int[n];
    int[] indeg = new int[n];
    forall j in [0..n-1] : indeg[j] = pre[j].length;
    list<int> Q;
    for j in [0..n-1] :
      if (indeg[j] == 0) {
        G[j] = 0;
        Q.add(j);
      };
    while (!Q.isEmpty()) {
      int j = Q.removeFirst();
      for k in succ[j] : {
        indeg[k] = indeg[k] - 1;
        if (indeg[k] == 0) {
          G[k] = 1 + (max i in pre[k] : G[i]);
          Q.add(k);
        }
      };
    };
    return G;
  }
}
