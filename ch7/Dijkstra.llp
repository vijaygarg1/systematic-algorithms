// Classical Dijkstra: extract-min frontier vertex, relax outgoing edges.

class Dijkstra {
  int[] shortestPath(int[][] w, int s) {
    int n = w.length;
    int[] dist = new int[n];
    boolean[] fixed = new boolean[n];
    forall i in [0..n-1] : dist[i] = 2147483647;
    dist[s] = 0;
    int count = 0;
    while (count < n) {
      // Linear scan for the unfixed vertex with the smallest dist.
      int j = -1;
      int best = 2147483647;
      int k = 0;
      while (k < n) {
        if (!fixed[k] && dist[k] < best) {
          j = k;
          best = dist[k];
        };
        k = k + 1;
      };
      if (j == -1) {
        return dist;
      };
      fixed[j] = true;
      count = count + 1;
      // Relax outgoing edges of j.
      k = 0;
      while (k < n) {
        if (!fixed[k] && w[j][k] < 2147483647) {
          if (dist[j] + w[j][k] < dist[k]) {
            dist[k] = dist[j] + w[j][k];
          }
        };
        k = k + 1;
      }
    };
    return dist;
  }
}
