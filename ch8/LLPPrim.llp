// LLP-Prim: each non-root vertex advances when the global cross-cut is its
// lightest edge.
//
// setBase(1) because every aux method here loops i = 1; while (i <= n),
// a 1-indexed convention with index 0 unused. Declaring it makes
// this.n = parent.length - 1; without it this.n = parent.length and those
// same loops read parent[n], one past the end.
//
// PRECONDITION the caller must establish, which this program cannot check:
// on entry fixed[v] means "following the chosen edges from v reaches the
// root" (the book's derived definition, bxx-mst-llp-prim.tex). fixed,
// parent and C all arrive as parameters and propagateFixed() runs only
// inside the advance, so nothing here establishes that meaning. Either the
// book's initialization (lightest-edge parents, then propagate fixed from
// the root BEFORE the first advance) or the demo's (parent[v] := v,
// fixed := {root}, C[v] := 0, which degenerates to classical Prim) works,
// and both reach the same C. Lightest-edge parents WITHOUT that initial
// propagation do not: vertices that should already be fixed look free, and
// roughly a quarter of random graphs come out wrong.

class LLPPrim {
  double[] LLPPrim(int[] parent, boolean[] fixed,
                   double[][] W, double[] C, int root) {
    setBase(1);
    forbidden (j) : !fixed[j]
                 && minCrossCut(j) < infinity
                 && minCrossCut(j) <= globalMinCrossCut()
                 && C[j] < minCrossCut(j)  =>
      advance : {
        int i = argMinCrossCut(j);
        parent[j] = i; C[j] = W[i][j];
        propagateFixed();
      };
    return C;
  }

  // Min weight of an edge (i, j) with fixed[i]; infinity when j has no
  // fixed neighbour, which is also the test the forbidden predicate needs.
  double minCrossCut(int j) {
    double best = infinity;
    forall i in [1..n] : {
      if (fixed[i] && W[i][j] < best) { best = W[i][j]; };
    };
    return best;
  }

  // The lightest edge in the cross-cut set E'(C). Infinity when E' is empty
  // (every vertex fixed, or the graph disconnected).
  double globalMinCrossCut() {
    double best = infinity;
    forall t in [1..n] : {
      if (!fixed[t] && minCrossCut(t) < best) { best = minCrossCut(t); };
    };
    return best;
  }

  // The fixed neighbour i achieving minCrossCut(j). Only the advance needs
  // the index rather than the weight, and it runs only where the guard has
  // already established that some fixed neighbour achieves it.
  int argMinCrossCut(int j) {
    int besti = 0 - 1;
    double best = infinity;
    forall i in [1..n] : {
      if (fixed[i] && W[i][j] < best) {
        best = W[i][j];
        besti = i;
      };
    };
    return besti;
  }

  // Mark every vertex whose parent chain now reaches a fixed vertex as
  // fixed. Idempotent; reaches a fixpoint in at most n rounds.
  void propagateFixed() {
    boolean changed = true;
    while (changed) {
      changed = false;
      forall j in [1..n] : if (!fixed[j] && fixed[parent[j]]) { fixed[j] = true; changed = true; };
    }
  }
}
