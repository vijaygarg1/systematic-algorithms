// Insertion sort: walk each new element down to its place.

class InsertionSort {
  void InsertionSort(int[] A) {
    int n = A.length;
    for i in [1..n-1] : {
      int j = i - 1;
      while (j >= 0) {
        if (A[j] <= A[j + 1]) { break; };
        swap(A[j], A[j + 1]);
        j = j - 1;
      };
    }
  }
}
