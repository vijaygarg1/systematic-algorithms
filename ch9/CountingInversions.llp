// Counting inversions by divide and conquer, matching bxx-divideConquer.tex
// Algorithm CountingInversions (algo:counting-inversions): inversions in the
// left half, plus those in the right half, plus those spanning the two,
// which a merge counts for free -- when A[j] from the right half is taken
// first, it is inverted with every element still left in the left half.
//
// Laid out as the book prints it: one declaration line for the four
// counters, and a single line for each leftover-copy loop.

class CountingInversions {
  int count(int[] A, int low, int high) {
    if (low >= high) { return 0; };
    int mid = (low + high) / 2;
    int invLeft = count(A, low, mid), invRight = count(A, mid + 1, high);
    int invMerge = mergeAndCount(A, low, mid, high);
    return invLeft + invRight + invMerge;
  }

  int mergeAndCount(int[] A, int low, int mid, int high) {
    // Sized to the sub-range, not to A.  `new int[A.length]` allocated and
    // zero-filled n elements on every one of the Theta(n) merge calls, which
    // costs Theta(n^2) on its own and swamped the O(n log n) the merging
    // itself achieves.
    int[] B = new int[high - low + 1];
    forall k in [low..high] : B[k - low] = A[k];
    int i = low, j = mid + 1, k = low, inv = 0;
    while (i <= mid && j <= high) {
      if (B[i - low] <= B[j - low]) {
        A[k] = B[i - low];
        i = i + 1;
      } else {
        A[k] = B[j - low];
        j = j + 1;
        inv = inv + (mid - i + 1);   // B[j - low] precedes all of B[i..mid]
      };
      k = k + 1;
    };
    while (i <= mid)  { A[k] = B[i - low]; i = i + 1; k = k + 1; };   // leftover left half
    while (j <= high) { A[k] = B[j - low]; j = j + 1; k = k + 1; };   // leftover right half
    return inv;
  }
}
