// LLP-CountInversions: count inversions to the left of each index.

class LLPCountInversions {
  void LLPCountInversions(int[] A) {
    int[] G = 0;
    ensure (j) : G[j] >= countLeft(A, j);
  }

  int countLeft(int[] A, int j) {
    int count = 0;
    forall i in [0..j-1] : {
      if (A[i] > A[j]) { count = count + 1; };
    };
    return count;
  }
}
