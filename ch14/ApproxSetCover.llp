// Greedy H_n-approximation for Set Cover: repeatedly pick the set covering the most uncovered elements.

class ApproxSetCover {
  boolean[] ApproxSetCover(int[][] mem, int[][] inc) {
    int m = mem.length;
    int n = inc.length;
    boolean[] C        = new boolean[m];
    boolean[] covered  = new boolean[n];
    int[] cnt          = new int[m];
    int remaining      = n;
    forall s in [0..m-1] : cnt[s] = mem[s].length;
    while (remaining > 0) {
      // Pick the set with the largest current coverage, lowest index on ties.
      int bestIdx   = 0;
      int bestCover = 0 - 1;
      int s = 0;
      while (s < m) {
        if (cnt[s] > bestCover) {
          bestCover = cnt[s];
          bestIdx   = s;
        };
        s = s + 1;
      };
      C[bestIdx] = true;
      // Cover its elements and charge the decrements to their incidences.
      int k = 0;
      while (k < mem[bestIdx].length) {
        int e = mem[bestIdx][k];
        if (!covered[e]) {
          covered[e] = true;
          remaining  = remaining - 1;
          int t = 0;
          while (t < inc[e].length) {
            cnt[inc[e][t]] = cnt[inc[e][t]] - 1;
            t = t + 1;
          };
        };
        k = k + 1;
      }
    };
    return C;
  }
}
