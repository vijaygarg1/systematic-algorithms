// LLP-Prim: each non-root vertex is fixed when the global cross-cut is its
// lightest edge, matching bxx-mst-llp-prim.tex Algorithm LLP-Prim
// (fig:alg-prim-imp).

class LLPPrim {
  double[] LLPPrim(int[][] adj, double[][] aw, int root) {
    int n = adj.length;
    double[] C = new double[n];
    double[] key = new double[n];
    int[] parent = new int[n];
    boolean[] fixed = new boolean[n];
    setContainer(PriorityQueue, key[j], min);
    forall v in [0..n-1] : { key[v] = infinity; parent[v] = 0 - 1; };
    key[root] = 0;
    forbidden (j in [0..n-1]) : !fixed[j] && key[j] < infinity =>
      advance : {
        fixed[j] = true;
        C[j] = key[j];
        int t = 0;
        while (t < adj[j].length) {
          int k = adj[j][t];
          if (!fixed[k] && aw[j][t] < key[k]) {
            key[k] = aw[j][t];
            parent[k] = j;
          };
          t = t + 1;
        };
      };
    return C;
  }
}
