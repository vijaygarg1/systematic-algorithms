// LLP-Assignment (bxx-assignment.tex, algo:llp-assignment): forbidden when
// item j belongs to an inclusion-minimal overdemanded set J (found via
// alternating-path reachability from an unmatched bidder, the standard witness
// for a violated Hall's condition); advance raises EVERY item in J by one
// shared slack-jump delta := min over bidders demanding into J of [best
// surplus - best surplus using an item outside J] -- the book's
// "G[j] := G[j]+delta for every j in J", not a per-item unit raise.
//
// J depends only on G, so it is computed ONCE per value of G and held in the
// fields itemInJ/bidderInB: the forbidden test refreshes it when stale and
// then just reads itemInJ[j], and the advance consumes the same arrays and
// marks them stale. The previous version recomputed the whole matching and
// reachability inside every forbidden(j) call -- n times per sweep -- and
// once more inside the advance.

class LLPAssignment {
  int[] LLPAssignment(int[][] v) {
    int n = v[0].length;
    int m = v.length;
    int[] G = new int[n];
    boolean[] itemInJ = new boolean[n];
    boolean[] bidderInB = new boolean[m];
    int[] partner = new int[n];
    boolean fresh = false;
    forbidden (j) : overdemanded(j) =>
      advance : raiseJ();
    return G;
  }

  // True iff item j is in the witness set for the current G.
  boolean overdemanded(int j) {
    refresh();
    return itemInJ[j];
  }

  // Rebuild itemInJ/bidderInB when G has moved since they were last built:
  // match the tight-edge graph, then mark everything alternating-reachable
  // from a bidder it leaves unmatched. A perfect matching leaves both arrays
  // clear, so no index is forbidden.
  void refresh() {
    if (!fresh) {
      forall i in [0..n-1] : { itemInJ[i] = false; partner[i] = 0 - 1; };
      forall b in [0..m-1] : bidderInB[b] = false;
      forall b in [0..m-1] : {
        boolean[] seen = new boolean[n];
        tryMatch(b, seen);
      };
      int u = firstUnmatched();
      if (u >= 0) { reach(u); };
      fresh = true;
    }
  }

  // Raise every item of J by the one shared slack jump: the least, over the
  // bidders demanding into J, of the drop from their best surplus to their
  // best surplus outside J.
  void raiseJ() {
    int delta = min b in [0..m-1] where bidderInB[b] : bestSurplus(b) - bestOutside(b);
    forall i in [0..n-1] : if (itemInJ[i]) { G[i] = G[i] + delta; };
    fresh = false;
  }

  // The first bidder the matching leaves unmatched, or -1 if it is perfect.
  int firstUnmatched() {
    int b = 0;
    while (b < m) {
      if (!(exists i in [0..n-1] : partner[i] == b)) { return b; };
      b = b + 1;
    };
    return 0 - 1;
  }

  int bestSurplus(int b) {
    return max i in [0..n-1] : v[b][i] - G[i];
  }

  // bestSurplus restricted to the items outside J.
  int bestOutside(int b) {
    return max i in [0..n-1] where !itemInJ[i] : v[b][i] - G[i];
  }

  // Mark every item and bidder alternating-reachable from bidder b.
  void reach(int b) {
    if (!bidderInB[b]) {
      bidderInB[b] = true;
      int best = bestSurplus(b);
      forall i in [0..n-1] :
        if (v[b][i] - G[i] == best && !itemInJ[i]) {
          itemInJ[i] = true;
          if (partner[i] != 0 - 1) { reach(partner[i]); }
        };
    }
  }

  boolean tryMatch(int b, boolean[] seen) {
    int best = bestSurplus(b);
    int i = 0;
    while (i < n) {
      if (v[b][i] - G[i] == best && !seen[i]) {
        seen[i] = true;
        if (partner[i] == 0 - 1 || tryMatch(partner[i], seen)) {
          partner[i] = b;
          return true;
        }
      };
      i = i + 1;
    };
    return false;
  }
}
