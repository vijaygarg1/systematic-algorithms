// Conjunctive predicate detection: forbidden when G[j] -> G[i] (happened-before);
// advance increments G[j] to the next local state.

class LLPConjunctiveDetection {
  int[] LLPConjunctiveDetection(int[][][] vc, int[] T) {
    int n = vc.length;
    int[] G = new int[n];
    forall k in [0..n-1] : G[k] = 1;
    forbidden (j in [0..n-1]) : happenedBefore(j, G, vc) =>
      advance : {
        if (G[j] >= T[j]) {
          return null;
        } else {
          G[j] = G[j] + 1;
        }
      };
    return G;
  }

  boolean happenedBefore(int j, int[] G, int[][][] vc) {
    int n = G.length;
    forall i in [0..n-1] : {
      if (i != j && vc[i][G[i]][j] >= G[j]) {
        return true;
      };
    };
    return false;
  }
}
