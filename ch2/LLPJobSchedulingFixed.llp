// LLP-JobScheduling-Fixed: advance each job once all predecessors are fixed.

class LLPJobSchedulingFixed {
  int[] LLPJobSchedulingFixed(int[] t, set<int>[] pre) {
    int[] G = new int[n];
    boolean[] fixed = new boolean[n];
    forall k in [0..n-1] : G[k] = t[k];
    forbidden (j in [0..n-1]) : !fixed[j] && forall i in pre[j] : fixed[i] =>
      advance : {
        G[j] = max(t[j], max i in pre[j] : G[i] + t[j]);
        fixed[j] = true;
      };
    return G;
  }
}
