// LLP-GCD: forbidden when some G[i] < G[j]; advance shrinks G[j] via mod.

int[] LLP_GCD(int[0..n-1] A) {
  int[0..n-1] G = 0;
  forall k in [0..n-1] : G[k] = A[k];
  forbidden (j) : exists i in [0..n-1] pick i : G[j] > G[i]  =>
    advance :
      if (G[j] % G[i] == 0) { G[j] = G[i];
        } else { G[j] = G[j] % G[i];
      };
  return G;
}
