// Strassen's matrix multiplication: 7 recursive products instead of 8.

Matrix strassen(Matrix A, Matrix B, int n) {
  if (n == 1) {
    return matrix(A[0][0] * B[0][0]);
  };
  Matrix A11, A12, A21, A22 = split(A, n);
  Matrix B11, B12, B21, B22 = split(B, n);
  Matrix M1 = strassen(add(A11, A22), add(B11, B22), n / 2);
  Matrix M2 = strassen(add(A21, A22), B11, n / 2);
  Matrix M3 = strassen(A11, sub(B12, B22), n / 2);
  Matrix M4 = strassen(A22, sub(B21, B11), n / 2);
  Matrix M5 = strassen(add(A11, A12), B22, n / 2);
  Matrix M6 = strassen(sub(A21, A11), add(B11, B12), n / 2);
  Matrix M7 = strassen(sub(A12, A22), add(B21, B22), n / 2);
  Matrix C11 = add(sub(add(M1, M4), M5), M7);
  Matrix C12 = add(M3, M5);
  Matrix C21 = add(M2, M4);
  Matrix C22 = add(sub(add(M1, M3), M2), M6);
  return combine(C11, C12, C21, C22);
}
