// Classical augmenting-path bipartite matching, matching
// bxx-matchingReduced.tex Algorithm Seq-AugmentingPath (algo:seq-bipartite):
// for each L-vertex j in turn, look for an alternating path to some free
// R-vertex k (S[k] unmatched). The book's abstract "there exists an
// alternating path..." step, plus its "assign S[] along the path"
// follow-up, are both realized here by the alternatingPath(...) DFS --
// the standard way of implementing that check.

class SeqAugmentingPath {
  int[] SeqAugmentingPath(int[][] adj) {
    int n = adj.length;
    int m = adj[0].length;
    int[] G = new int[n];
    int[] S = new int[m];
    forall j in [0..n-1] : G[j] = 0;
    forall k in [0..m-1] : S[k] = 0 - 1;
    forall j in [0..n-1] : {
      boolean[] seen = new boolean[m];
      if (alternatingPath(j, adj, S, seen)) {
        G[j] = 1;
      };
    };
    return G;
  }

  // "There exists an alternating path from v_j to any vertex k in R with
  // S[k] unmatched": a DFS over R-neighbors of j. A free neighbor k ends
  // the search directly; an already-matched k is tried by recursing into
  // its current L-partner, to see if that partner can be re-matched
  // elsewhere and free k up for j.
  boolean alternatingPath(int j, int[][] adj, int[] S, boolean[] seen) {
    int m = adj[0].length;
    forall k in [0..m-1] : {
      if (adj[j][k] == 1 && !seen[k]) {
        seen[k] = true;
        if (S[k] == 0 - 1 || alternatingPath(S[k], adj, S, seen)) {
          S[k] = j;
          return true;
        }
      };
    };
    return false;
  }
}
