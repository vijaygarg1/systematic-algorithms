// Ord: multiplicative order of a modulo n via descending LLP on divisor lattice.
// G[i] = exponent of p[i] in the current candidate k = prod p[i]^G[i].

class Ord {
  int Ord(int a, int n, int[] p, int[] e) {
    int s = p.length;
    int[] G = new int[s];
    forall i in [0..s-1] : G[i] = e[i];
    int k = 1;
    int i = 0;
    while (i < s) {
      int j = 0;
      while (j < e[i]) {
        k = k * p[i];
        j = j + 1;
      };
      i = i + 1;
    };
    boolean changed = true;
    while (changed) {
      changed = false;
      i = 0;
      while (i < s) {
        if (G[i] > 0 && modpow(a, k / p[i], n) == 1) {
          G[i] = G[i] - 1;
          k = k / p[i];
          changed = true;
        };
        i = i + 1;
      }
    };
    return k;
  }

  int modpow(int base, int exp, int mod) {
    int result = 1;
    int b = base % mod;
    int e = exp;
    while (e > 0) {
      if (e % 2 == 1) {
        result = (result * b) % mod;
      };
      e = e / 2;
      b = (b * b) % mod;
    };
    return result;
  }
}
