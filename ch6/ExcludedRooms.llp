// ExcludedRooms: composition program enforcing that course j is not
// assigned a room from its excluded set R[j].  Composed onto
// LLP-IntervalPartition via predicate conjunction:
//   [ LLP-IntervalPartition(s, f, G) && ExcludedRooms(R, G) ].

class ExcludedRooms {
  int[] ExcludedRooms(set<int>[] R, int[] G, set<int>[] pre) {
    forbidden (j) : exists r in R[j] : G[j] == r =>
      advance : G[j] = leastValidRoom(j);
    return G;
  }

  int leastValidRoom(int j) {
    int r = 1;
    boolean conflict = true;
    while (conflict) {
      conflict = false;
      forall x in R[j] :
        if (x == r) { conflict = true; };
      if (!conflict) {
        forall k in pre[j] :
          if (G[k] == r) { conflict = true; };
      };
      if (conflict) { r = r + 1; }
    };
    return r;
  }
}
