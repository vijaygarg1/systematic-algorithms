// LLP form of Johnson reweighting: raise prices G[j] until every reduced edge weight is non-negative.

class LLPJohnson {
  int[] LLPJohnson(int[][] pre, int[][] pw) {
    int[] G = 0;
    forbidden (j in [0..n-1]) : reducedNegative(j) =>
      advance :
        forall k in [0..n-1] : G[k] = raised(k);
    return G;
  }

  // Some edge into j is still negative under the current prices.
  boolean reducedNegative(int j) {
    int t = 0;
    while (t < pre[j].length) {
      if (G[j] < G[pre[j][t]] - pw[j][t]) { return true; };
      t = t + 1;
    };
    return false;
  }

  // G[k] raised to the largest price any edge into k demands.
  int raised(int k) {
    int best = G[k];
    int t = 0;
    while (t < pre[k].length) {
      int cand = G[pre[k][t]] - pw[k][t];
      if (cand > best) { best = cand; };
      t = t + 1;
    };
    return best;
  }
}
