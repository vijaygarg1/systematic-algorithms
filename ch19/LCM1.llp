// LCM1: ascending LLP to find least common multiple.
// Forbidden when G[j] < G[i]; advance jumps to next multiple of A[j] >= G[i].

int[] LCM1(int[] A) {
  int[] G = 0;
  forall k in [0..n-1] : G[k] = A[k];
  forbidden (j) : exists i in [0..n-1] pick i : G[j] < G[i] =>
    advance : G[j] = G[j] + ((G[i] - G[j] + A[j] - 1) / A[j]) * A[j];
  return G;
}
