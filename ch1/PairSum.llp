// Count pairs (i, j) with i < j and A[i] + A[j] = target.

int PairSum(int[] A, int target) {
  int count = 0;
  int i = 0;
  while (i < A.length) {
    int j = i + 1;
    while (j < A.length) {
      if (A[i] + A[j] == target) { count = count + 1; };
      j = j + 1;
    };
    i = i + 1;
  };
  return count;
}
