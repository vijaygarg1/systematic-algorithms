// Par-CRT: ascending parallel Chinese Remainder Theorem.
// Forbidden when G[j] < G[i] for some i;
// advance jumps to next multiple-of-m[j] congruence >= G[i].

int[] ParCRT(int[] m, int[] b) {
  int[] G = 0;
  forall k in [0..n-1] : G[k] = b[k];
  forbidden (j) : exists i in [0..n-1] pick i : G[j] < G[i] =>
    advance : G[j] = G[j] + ((G[i] - G[j] + m[j] - 1) / m[j]) * m[j];
  return G;
}
