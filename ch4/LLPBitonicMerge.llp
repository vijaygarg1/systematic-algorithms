// LLP-BitonicMerge: forbidden when a pair at distance m is inverted.

class LLPBitonicMerge {
  void LLPBitonicMerge(int[] A, int n) {
    forbidden (i, m) : A[i] > A[i + m] =>
      advance : swap(A[i], A[i + m]);
    // priority: for m = n, n/2, ..., 1:
    //   evaluate all i with (i - 1) % (2 * m) < m in parallel
  }
}
