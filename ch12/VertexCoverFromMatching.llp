// Koenig's theorem: minimum vertex cover of size |M| from a maximum
// bipartite matching, via alternating reachability. Matches
// bxx-matchingReduced.tex Algorithm VertexCoverFromMatching: Z is the set
// of vertices reachable from an unmatched L-vertex by an alternating path
// (non-matching edge, then matching edge, ...); C := (L \ Z) union (R

class VertexCoverFromMatching {
  boolean[] VertexCoverFromMatching(int[][] adj, int nr, int[] matchL) {
    int L = adj.length;
    int R = nr;
    int[] matchR = new int[R];
    forall v in [0..R-1] : matchR[v] = 0 - 1;
    forall j in [0..L-1] : if (matchL[j] != 0 - 1) { matchR[matchL[j]] = j; };

    // Z := set of unmatched vertices in L; Q := Z.
    boolean[] inZ = new boolean[L + R];
    int[] Q = new int[L + R];
    int head = 0;
    int tail = 0;
    forall j in [0..L-1] :
      if (matchL[j] == 0 - 1) {
        inZ[j] = true;
        Q[tail] = j;
        tail = tail + 1;
      };

    while (head < tail) {
      int w = Q[head];
      head = head + 1;
      if (w < L) {
        // w in L: follow every (w, v) in E \ M with v not in Z.
        int t = 0;
        while (t < adj[w].length) {
          int v = adj[w][t];
          if (matchL[w] != v && !inZ[L + v]) {
            inZ[L + v] = true;
            Q[tail] = L + v;
            tail = tail + 1;
          };
          t = t + 1;
        };
      } else {
        // w in R: if w is matched and partner[w] not in Z, add it.
        int r = w - L;
        if (matchR[r] != 0 - 1 && !inZ[matchR[r]]) {
          inZ[matchR[r]] = true;
          Q[tail] = matchR[r];
          tail = tail + 1;
        };
      }
    };

    // C := (L \ Z) union (R intersect Z).
    boolean[] C = new boolean[L + R];
    forall j in [0..L-1] : C[j] = !inZ[j];
    forall v in [0..R-1] : C[L + v] = inZ[L + v];
    return C;
  }
}
