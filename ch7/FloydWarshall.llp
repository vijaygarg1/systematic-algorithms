// Floyd-Warshall APSP: triple loop on intermediate vertex.

class FloydWarshall {
  void FloydWarshall(int[][] G) {
    int n = G.length;
    int k = 0;
    while (k < n) {
      int i = 0;
      while (i < n) {
        int j = 0;
        while (j < n) {
          if (G[i][k] != infinity && G[k][j] != infinity) {
            if (G[i][k] + G[k][j] < G[i][j]) {
              G[i][j] = G[i][k] + G[k][j];
            }
          };
          j = j + 1;
        };
        i = i + 1;
      };
      k = k + 1;
    }
  }
}
