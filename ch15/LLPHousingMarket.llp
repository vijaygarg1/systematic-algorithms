//
//   boolean wishInSubmatching(int j, int[] G, int[][] pref) {
//     int n = G.length;
//     int wish = pref[j][G[j]];
//     int i = 0;
//     while (i < n) {
//       if (pref[i][G[i]] == wish && inSubmatching(i, G, pref)) {
//         return true;
