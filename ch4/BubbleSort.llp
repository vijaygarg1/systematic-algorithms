// Bubble sort: repeated adjacent compare-and-swap until a clean pass.

class BubbleSort {
  void sort(int[] A) {
    boolean found = true;
    while (found) {
      found = false;
      forall j in [0..A.length - 1-1] : {
        if (A[j] > A[j + 1]) {
          found = true;
          swap(A[j], A[j + 1]);
        };
      }
    }
  }
}
