// LLP FPTAS for Knapsack, matching bxx-approximate.tex Algorithm
// LLP-ApproxKnapsack (fig:llp-approxknapsack): discard items that cannot
// fit, then run a profit-indexed min-weight DP D[i][p] on a lattice of
// size (nf+1) x (V'+1), V' = O(nf^2/eps), where nf is the number of
// feasible items. Fully polynomial.
// D[i][p] = minimum total weight of a subset of the first i feasible
// items with scaled profit >= p; the answer is max { p : D[nf][p] <= W },
// profit mu * p.
//
// Forbidden(i,p) with i>=1,p>=1: D[i,p] > min(D[i-1,p], w_i + D[i-1,max(0,p-v_i')]);
// Advance: D[i,p] := that min -- realized below with the native
// forbidden(i,p) => advance: ... construct. The guard's shared bound n is
// set to max(nf,Vp)+1 (rather than nf+1 or Vp+1 individually, since the
// compiler infers one bound for every index of a guard) and the
// predicate explicitly re-restricts i to [1..nf] and p to [1..Vp], so
// out-of-range (i,p) pairs in the padded square scan are simply never
// forbidden. Every value the guard or its advance touches by bare name
// (D, fw, vPrime, nf, Vp) must be a class field for the auto-generated
// forbidden/advance helpers to see it, which this compiler only grants
// to a *leading, uninterrupted run* of declarations at the very top of
// the entry method -- hence the preprocessing (which genuinely needs
// loops: discarding items, scaling profits, summing) is factored into
// helper methods, so the entry method itself is nothing but one
// declaration per step, each a single call.

class LLPApproxKnapsack {
  int LLPApproxKnapsack(int[] w, int[] v, int W, int epsNum, int epsDen) {
    int nf = countFeasible(w, W);
    int[] fw = feasibleWeights(w, W, nf);
    int[] fv = feasibleValues(w, v, W, nf);
    int M = maxProfit(fv, nf);
    int[] vPrime = scaledProfits(fv, nf, M, epsNum, epsDen);
    int Vp = sumVPrime(vPrime, nf);
    int INF = totalWeightPlusOne(fw, nf);
    int[][] D = initTable(nf, Vp, INF);
    n = max(nf, Vp) + 1;
    forbidden (i, p) :
      i >= 1 && i <= nf && p >= 1 && p <= Vp &&
      D[i][p] > min(D[i - 1][p], fw[i - 1] + D[i - 1][max(0, p - vPrime[i - 1])])
    =>
      advance : D[i][p] = min(D[i - 1][p], fw[i - 1] + D[i - 1][max(0, p - vPrime[i - 1])]);
    return readPStar(D, nf, Vp, W);
  }

  // Number of items that fit the capacity on their own (discard the rest:
  // they can never be in a feasible solution).
  int countFeasible(int[] w, int W) {
    int nf = 0;
    int i = 0;
    while (i < w.length) {
      if (w[i] <= W) { nf = nf + 1; };
      i = i + 1;
    };
    return nf;
  }

  int[] feasibleWeights(int[] w, int W, int nf) {
    int[] fw = new int[nf];
    int k = 0;
    int i = 0;
    while (i < w.length) {
      if (w[i] <= W) { fw[k] = w[i]; k = k + 1; };
      i = i + 1;
    };
    return fw;
  }

  int[] feasibleValues(int[] w, int[] v, int W, int nf) {
    int[] fv = new int[nf];
    int k = 0;
    int i = 0;
    while (i < w.length) {
      if (w[i] <= W) { fv[k] = v[i]; k = k + 1; };
      i = i + 1;
    };
    return fv;
  }

  // M = max profit among feasible items (this item fits, so M <= OPT).
  int maxProfit(int[] fv, int nf) {
    int M = 1;
    if (nf > 0) {
      M = fv[0];
      int i = 1;
      while (i < nf) { M = max(M, fv[i]); i = i + 1; };
    };
    return M;
  }

  // v'[k] = floor(fv[k] / mu), mu = eps*M/nf.
  int[] scaledProfits(int[] fv, int nf, int M, int epsNum, int epsDen) {
    int[] vPrime = new int[nf];
    int i = 0;
    while (i < nf) { vPrime[i] = (fv[i] * nf * epsDen) / (epsNum * M); i = i + 1; };
    return vPrime;
  }

  // V' = sum of the scaled profits.
  int sumVPrime(int[] vPrime, int nf) {
    int Vp = 0;
    int i = 0;
    while (i < nf) { Vp = Vp + vPrime[i]; i = i + 1; };
    return Vp;
  }

  // A weight strictly above any achievable total weight.
  int totalWeightPlusOne(int[] fw, int nf) {
    int INF = 1;
    int i = 0;
    while (i < nf) { INF = INF + fw[i]; i = i + 1; };
    return INF;
  }

  // D[i][p] initialized to INF, except profit 0 needs weight 0.
  int[][] initTable(int nf, int Vp, int INF) {
    int[][] D = new int[nf + 1][Vp + 1];
    int i = 0;
    while (i <= nf) {
      int p = 0;
      while (p <= Vp) {
        D[i][p] = INF;
        if (p == 0) { D[i][p] = 0; };
        p = p + 1;
      };
      i = i + 1;
    };
    return D;
  }

  // p* = max { p : D[nf][p] <= W }.
  int readPStar(int[][] D, int nf, int Vp, int W) {
    int pStar = 0;
    int q = 0;
    while (q <= Vp) {
      if (D[nf][q] <= W) { pStar = q; };
      q = q + 1;
    };
    return pStar;
  }
}
