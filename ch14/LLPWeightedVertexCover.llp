// LLP-WeightedVertexCover: primal-dual 2-approximation for weighted
// vertex cover, matching bxx-approximate.tex Algorithm
// LLP-WeightedVertexCover (fig:llp-wvc). G[u][v] is the price on edge
// {u,v}; a vertex v is tight when its incident prices saturate w[v]; an
// edge is slack when neither endpoint is tight; slackMin(u,v) further
// requires {u,v} to be lex-minimal among every slack edge sharing an
// endpoint with it -- the same lex-minimality check as
// LLPLexMatchVertexCover, just over slack edges instead of
// uncovered ones. Advancing raises the edge's price by the smaller of
// its two endpoints' remaining budgets, tightening at least one.

class LLPWeightedVertexCover {
  boolean[] LLPWeightedVertexCover(int[][] adj, double[] w) {
    int nv = w.length;
    double[][] G = new double[nv][nv];
    forbidden (u, v) : u < v && slackMin(u, v) =>
      advance : {
        double step = min(w[u] - price(u), w[v] - price(v));
        G[u][v] = G[u][v] + step;
        G[v][u] = G[u][v];
      };
    boolean[] C = new boolean[nv];
    forall i in [0..nv-1] : C[i] = tight(i);
    return C;
  }

  // Total dual charged to v across its incident edges.
  double price(int v) {
    double total = 0.0;
    forall u in [0..nv-1] : {
      if (adj[u][v] == 1) { total = total + G[u][v]; };
    };
    return total;
  }

  boolean tight(int v) {
    return price(v) >= w[v];
  }

  boolean slack(int u, int v) {
    return !tight(u) && !tight(v);
  }

  // Edge (u, v) is slack and lex-minimal among every slack edge sharing an
  // endpoint with it -- i.e. no slack edge (x, y) that touches u or v is
  // lexicographically smaller.
  boolean slackMin(int u, int v) {
    return adj[u][v] == 1 && slack(u, v)
        && !(exists x in [0..nv-1] : (exists y in [x+1..nv-1] :
               (adj[x][y] == 1 && (x == u || x == v || y == u || y == v)
                && slack(x, y) && lexLess(x, y, u, v)
                && !(x == u && y == v))));
  }

  // Edge (a, b) is lexicographically smaller than (c, d).
  boolean lexLess(int a, int b, int c, int d) {
    if (a < c) { return true; };
    if (a > c) { return false; };
    return b < d;
  }
}
