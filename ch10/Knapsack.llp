// 0/1 knapsack: O(nW) bottom-up table fill.

class Knapsack {
  int[][] solve(int[] w, int[] v, int W) {
    int n = w.length - 1;
    int[][] G = new int[n + 1][W + 1];
    forall c in [0..W] : G[0][c] = 0;
    forall i in [0..n] : G[i][0] = 0;
    forall i in [1..n] :
      forall c in [1..W] :
        if (w[i] > c) {
          G[i][c] = G[i - 1][c];
        } else {
          G[i][c] = max(G[i - 1][c], G[i - 1][c - w[i]] + v[i]);
        };
    return G;
  }
}
