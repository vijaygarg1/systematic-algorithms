// LLP-Prim: each non-root vertex advances when the global cross-cut is its lightest edge.
//
// setBase(1): every aux method here (minCrossCut, argMinCrossCut,
// globalMinCrossCut, propagateFixed) loops `i = 1; while (i <= n)`,
// a 1-indexed convention (index 0 reserved/unused) that was never
// declared -- without it, this.n = parent.length (0-indexed), so the
// very same loops read/write parent[n], one past the end of a
// length-n array. Declaring the 1-indexed base makes this.n =
// parent.length - 1, matching the loops as written (confirmed: this
// is the same setBase(1) convention LLP_StableMarriage uses for its
// own 1-indexed aux methods).

// PRECONDITION on the caller, which this program cannot check: on
// entry, fixed[v] must mean "following the chosen edges from v reaches
// the root" -- the book's derived definition of fixed (see
// bxx-mst-llp-prim.tex). fixed, parent and C all arrive as parameters,
// and propagateFixed() runs only inside the advance, so nothing here
// establishes that meaning.
//
// Two initializations satisfy it:
//   (a) the book's -- parent[v] := v's lightest-edge neighbour, C[v] :=
//       that weight, then propagate fixed from the root along those
//       chains before the first advance. Vertices then become fixed in
//       chains, and the example in the book settles 5 vertices in 2
//       advances.
//   (b) the demo's -- parent[v] := v, fixed := {root}, C[v] := 0. No
//       chain can be fixed prematurely because no parent points away
//       from v, and the program degenerates to classical Prim: one
//       advance per vertex.
// Both reach the same C. What is NOT safe is (a) without the initial
// propagation -- lightest-edge parents with fixed = {root} alone --
// which leaves vertices that should already be fixed looking free and
// yields a wrong answer on roughly a quarter of random graphs.

class LLPPrim {
  double[] LLPPrim(int[] parent, boolean[] fixed,
                   double[][] W, double[] C, int root) {
    setBase(1);
    forbidden (j) : !fixed[j]
                 && argMinCrossCut(j) >= 1
                 && minCrossCut(j) <= globalMinCrossCut()
                 && C[j] < minCrossCut(j)  =>
      advance : {
        int i = argMinCrossCut(j);
        parent[j] = i;
        C[j] = W[i][j];
        propagateFixed();
      };
    return C;
  }

  // The vertex i that achieves the minimum weight W[i][j] among fixed
  // neighbours of j; -1 when no fixed neighbour is incident to j.
  int argMinCrossCut(int j) {
    int besti = 0 - 1;
    double best = infinity;
    int i = 1;
    while (i <= n) {
      if (fixed[i] && W[i][j] < best) {
        best = W[i][j];
        besti = i;
      };
      i = i + 1;
    };
    return besti;
  }

  // Min weight of an edge (i, j) with fixed[i] = true; infinity if no
  // such edge exists yet.
  double minCrossCut(int j) {
    int i = argMinCrossCut(j);
    if (i == 0 - 1) { return infinity; };
    return W[i][j];
  }

  // Global minimum of minCrossCut(j) over every non-fixed j, equivalently
  // the lightest edge in the cross-cut set E'(C).  Returns infinity when
  // E' is empty (all vertices fixed, or graph disconnected).
  double globalMinCrossCut() {
    return min t in [1..n] : crossCutIfFree(t);
  }

  // minCrossCut, but infinity at an already-fixed vertex, so a fixed t can
  // never win the minimum above.  The test is load-bearing: argMinCrossCut
  // scans the *fixed* neighbours of its argument, so it still reports a
  // real edge for a t that is itself fixed.
  double crossCutIfFree(int t) {
    if (fixed[t]) { return infinity; };
    return minCrossCut(t);
  }

  // Mark every vertex whose parent chain now reaches a fixed vertex as
  // fixed.  Idempotent; reaches a fixpoint in at most n rounds.
  void propagateFixed() {
    boolean changed = true;
    while (changed) {
      changed = false;
      int j = 1;
      while (j <= n) {
        if (!fixed[j] && fixed[parent[j]]) {
          fixed[j] = true;
          changed = true;
        };
        j = j + 1;
      };
    }
  }
}
