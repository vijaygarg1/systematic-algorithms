// Classical 2-SAT via Kosaraju's strongly-connected components.

class TwoSAT {
  boolean[] TwoSAT(int[] clauseA, int[] clauseB) {
    int m = clauseA.length, n = max(0, max i in [0..m-1] : max(abs(clauseA[i]), abs(clauseB[i])));
    int sz = 2 * n + 2, cap = 2 * m + 1;
    int[][] adjFwd = new int[sz][cap], adjRev = new int[sz][cap];
    int[] degFwd = new int[sz], degRev = new int[sz];
    forall i in [0..m-1] : {
      addImplication(litIndex(0 - clauseA[i], n), litIndex(clauseB[i], n), adjFwd, degFwd, adjRev, degRev);
      addImplication(litIndex(0 - clauseB[i], n), litIndex(clauseA[i], n), adjFwd, degFwd, adjRev, degRev);
    };

    // Pass 1: push every literal onto order after its descendants.
    int[] order = new int[sz];
    int orderSize = 0, v = 0;
    boolean[] visited = new boolean[sz];
    while (v < sz) {
      if (!visited[v]) { orderSize = dfs1(v, adjFwd, degFwd, visited, order, orderSize); };
      v = v + 1;
    };

    // Pass 2: pop that order and flood the REVERSE graph; each flood is
    // one strongly-connected component.
    int[] comp = new int[sz];
    forall k in [0..sz-1] : comp[k] = 0 - 1;
    int numComp = 0, idx = orderSize - 1;
    while (idx >= 0) {
      if (comp[order[idx]] < 0) {
        dfs2(order[idx], adjRev, degRev, comp, numComp); numComp = numComp + 1;
      };
      idx = idx - 1;
    };

    boolean[] result = new boolean[n + 1];
    forall x in [1..n] : result[x] = comp[x] > comp[n + x];
    return result;
  }

  void addImplication(int from, int to, int[][] adjFwd, int[] degFwd, int[][] adjRev, int[] degRev) {
    adjFwd[from][degFwd[from]] = to; degFwd[from] = degFwd[from] + 1;
    adjRev[to][degRev[to]] = from; degRev[to] = degRev[to] + 1;
  }

  int dfs1(int u, int[][] adj, int[] deg, boolean[] visited, int[] order, int orderSize) {
    visited[u] = true;
    forall i in [0..deg[u]-1] : {
      int w = adj[u][i];
      if (!visited[w]) { orderSize = dfs1(w, adj, deg, visited, order, orderSize); };
    };
    order[orderSize] = u;
    return orderSize + 1;
  }

  void dfs2(int u, int[][] adj, int[] deg, int[] comp, int c) {
    comp[u] = c;
    forall i in [0..deg[u]-1] : {
      int w = adj[u][i];
      if (comp[w] < 0) { dfs2(w, adj, deg, comp, c); };
    }
  }

  int litIndex(int lit, int n) {
    if (lit > 0) { return lit; };
    return n + (0 - lit);
  }
}
