// Strassen's divide-and-conquer matrix multiplication over int[][].
// Splitting each n x n operand into four n/2 quadrants, the product needs
// only SEVEN recursive multiplications instead of the obvious eight, which
// is what drops the exponent from 3 to log2(7) ~ 2.81. The saving comes
// from M1..M7 below: each is one product of sums, and the four output

class Strassen {
  int[][] multiply(int[][] A, int[][] B) {
    int n = A.length;
    if (n == 1) { int[][] C1 = new int[1][1]; C1[0][0] = A[0][0] * B[0][0]; return C1; };
    int h = n / 2;
    int[][] A11 = quadrant(A, 0, 0, h), A12 = quadrant(A, 0, h, h),
            A21 = quadrant(A, h, 0, h), A22 = quadrant(A, h, h, h);
    int[][] B11 = quadrant(B, 0, 0, h), B12 = quadrant(B, 0, h, h),
            B21 = quadrant(B, h, 0, h), B22 = quadrant(B, h, h, h);
    int[][] M1 = multiply(add(A11, A22), add(B11, B22)), M2 = multiply(add(A21, A22), B11),
            M3 = multiply(A11, sub(B12, B22)),           M4 = multiply(A22, sub(B21, B11)),
            M5 = multiply(add(A11, A12), B22),           M6 = multiply(sub(A21, A11), add(B11, B12)),
            M7 = multiply(sub(A12, A22), add(B21, B22));
    int[][] C11 = add(sub(add(M1, M4), M5), M7), C12 = add(M3, M5),
            C21 = add(M2, M4),                   C22 = add(add(sub(M1, M2), M3), M6);
    return combine(C11, C12, C21, C22);
  }

  int[][] quadrant(int[][] M, int r, int c, int h) {
    int[][] Q = new int[h][h];
    forall i in [0..h-1] : forall j in [0..h-1] : Q[i][j] = M[r + i][c + j];
    return Q;
  }

  // Elementwise sum of two equal-sized square matrices.
  int[][] add(int[][] X, int[][] Y) {
    int h = X.length;
    int[][] S = new int[h][h];
    forall i in [0..h-1] : forall j in [0..h-1] : S[i][j] = X[i][j] + Y[i][j];
    return S;
  }

  // Elementwise difference of two equal-sized square matrices.
  int[][] sub(int[][] X, int[][] Y) {
    int h = X.length;
    int[][] D = new int[h][h];
    forall i in [0..h-1] : forall j in [0..h-1] : D[i][j] = X[i][j] - Y[i][j];
    return D;
  }

  int[][] combine(int[][] C11, int[][] C12, int[][] C21, int[][] C22) {
    int h = C11.length;
    int[][] C = new int[2 * h][2 * h];
    forall i in [0..h-1] : forall j in [0..h-1] : {
      C[i][j] = C11[i][j];       C[i][j + h] = C12[i][j];
      C[i + h][j] = C21[i][j];   C[i + h][j + h] = C22[i][j];
    };
    return C;
  }
}
