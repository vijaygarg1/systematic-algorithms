// Classical Johnson all-pairs shortest paths: BellmanFord computes a
// non-negative price vector that reweights edges, then Dijkstra runs from
// every source on the reweighted graph. Returns null on negative cycle.

class Johnson {
  int[][] allPairs(int[][] adj, int[][] aw) {
    int n = adj.length;
    int INF = infinity;

    // Step 1: BellmanFord from an auxiliary source with a 0-weight edge to
    // every vertex, so every dist starts at 0. Stops early once a pass
    // changes nothing.
    int[] dist = new int[n];
    int k = 0;
    while (k < n - 1) {
      boolean changed = false;
      forall i in [0..n-1] : {
        int t = 0;
        while (t < adj[i].length) {
          int j = adj[i][t];
          if (dist[i] + aw[i][t] < dist[j]) {
            dist[j] = dist[i] + aw[i][t];
            changed = true;
          };
          t = t + 1;
        };
      };
      if (changed) { k = k + 1; } else { k = n; }
    };

    // One more pass: any further relaxation means a negative cycle.
    boolean negCycle = false;
    forall i in [0..n-1] : {
      int t = 0;
      while (t < adj[i].length) {
        if (dist[i] + aw[i][t] < dist[adj[i][t]]) { negCycle = true; };
        t = t + 1;
      };
    };
    if (negCycle) {
      return null;
    };

    // Steps 2 and 3: price[v] = -dist[v], then reweight every edge.
    int[] price = new int[n];
    forall v in [0..n-1] : price[v] = 0 - dist[v];
    int[][] awPrime = new int[n][];
    forall i in [0..n-1] : awPrime[i] = new int[adj[i].length];
    forall i in [0..n-1] : {
      int t = 0;
      while (t < adj[i].length) {
        awPrime[i][t] = reweight(aw[i][t], price[adj[i][t]], price[i]);
        t = t + 1;
      };
    };

    // Step 4: Dijkstra from every source; undo the reweighting.
    int[][] D = new int[n][n];
    forall u in [0..n-1] : {
      int[] distPrime = Dijkstra(adj, awPrime, u);
      forall v in [0..n-1] :
        D[u][v] = reweight(distPrime[v], price[u], price[v]);
    };
    return D;
  }

  // len + plus - minus, with infinity left alone. Steps 3 and 4 are the same
  // shift in opposite directions -- step 3 puts price[j] - price[i] onto edge
  // (i,j), step 4 takes price[u] - price[v] back off the path (u,v) -- so both
  // are this one helper with the two prices the other way round.
  int reweight(int len, int plus, int minus) {
    if (len >= infinity) { return infinity; };
    return len + plus - minus;
  }
}
