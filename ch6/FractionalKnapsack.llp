// Fractional knapsack: greedy by value-density v/w (last item may be split).

class FractionalKnapsack {
  double[] solve(double[] v, double[] w, double W) {
    int n = v.length;
    double[] x = new double[n];
    double rem = W;
    for i in [0..n-1] : {
      if (w[i] <= rem) {
        x[i] = 1.0;
        rem = rem - w[i];
      } else {
        x[i] = rem / w[i];                   // take the remaining fraction
        break;                               // knapsack is full
      }
    };
    return x;
  }
}
