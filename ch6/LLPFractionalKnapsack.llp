// LLP-FractionalKnapsack: items pre-sorted by v/w density; raise each
// fraction G[j] in [0,1] to its target G*[j], read in O(1) from one
// prefix scan of the weights.

class LLPFractionalKnapsack {
  double[] LLPFractionalKnapsack(double[] v, double[] w, double W) {
    double[] G = 0.0;
    double[] S = new double[n + 1];
    int i = 0;
    while (i < n) { S[i + 1] = S[i] + w[i]; i = i + 1; };
    forbidden (j in [0..n-1]) :
      G[j] < target(j)
    =>
      advance : G[j] = target(j);
    return G;
  }

  // G*[j]: 1 while the cumulative weight through j stays under W, the
  // partial fraction at the breakpoint, then 0.
  double target(int j) {
    if (S[j + 1] <= W) { return 1.0; };
    if (S[j] >= W) { return 0.0; };
    return (W - S[j]) / w[j];
  }
}
