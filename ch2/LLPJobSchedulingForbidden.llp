// LLP job scheduling: forbidden when G[j] < max_{i in pre[j]} G[i] + t[j].

// Prerequisites are acyclic -- a job cannot transitively depend on
// itself -- so `setAcyclic(pre)` states that as a condition on valid
// input.  It lets the jobs be settled once each, in dependency order,
// which is the schedule LLPJobSchedulingFixed writes out by hand with
// its `fixed` array.  Without it the program can only relax to a
// fixpoint, revisiting a job every time a prerequisite moves.
int[] LLPJobSchedulingForbidden(int[]       t, set<int>[]  pre) {
  int[]       G = 0;
  setAcyclic(pre);
  forall k in [0..n] : G[k] = t[k];
  forbidden (j in [0..n-1]) : G[j] < max i in pre[j] : G[i] + t[j] =>
    advance : G[j] = max i in pre[j] : G[i] + t[j];
  return G;
}
