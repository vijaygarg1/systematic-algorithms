// LLP parallel H_n-approximation for Set Cover: pick every set that
// maximises coverage among its neighbours and is lex-minimal among ties.
// A neighbour of j is another unpicked set sharing an uncovered element
// with j; j is forbidden (i.e. should be picked) when it still covers
// something and no neighbour outranks it.
//
// The predicate is tested without comparing set pairs. For each uncovered
// element keep best[e], the unpicked set covering the most uncovered
// elements that contains e (lowest index on ties); then j outranks every
// neighbour exactly when best[e] = j for every uncovered e in s_j, since
// the neighbours of j are precisely the unpicked sets sharing such an e.
// The coverage counts cnt[j] = |s_j ∩ R| and the covered[] flags are
// maintained by the advance, so coverage is read in O(1) instead of being
// recomputed -- it used to cost an O(m) scan per element, inside an O(u)
// scan per set, inside an O(m) scan over neighbours.

class LLPLexGreedySetCover {
  boolean[] LLPLexGreedySetCover(int[][] S) {
    int m = S.length;
    int u = S[0].length;
    boolean[] G = false;
    boolean[] covered = new boolean[u];
    int[] cnt = new int[m];
    int[] best = new int[u];
    boolean fresh = false;
    forall s in [0..m-1] : cnt[s] = count e in [0..u-1] : S[s][e] == 1;
    forbidden (j) : isLexMaxCov(j) =>
      advance : {
        G[j] = true;
        int e = 0;
        while (e < u) {
          if (S[j][e] == 1 && !covered[e]) {
            covered[e] = true;
            int t = 0;
            while (t < m) {
              if (S[t][e] == 1) { cnt[t] = cnt[t] - 1; };
              t = t + 1;
            };
          };
          e = e + 1;
        };
        fresh = false;
      };
    return G;
  }

  // j is unpicked, covers at least one uncovered element, and is the best
  // set at every uncovered element it holds -- so no neighbour beats it.
  boolean isLexMaxCov(int j) {
    if (G[j]) { return false; };
    refresh();
    if (cnt[j] <= 0) { return false; };
    int e = 0;
    while (e < u) {
      if (S[j][e] == 1 && !covered[e] && best[e] != j) { return false; };
      e = e + 1;
    };
    return true;
  }

  // Rebuild best[] after an advance has covered elements.
  void refresh() {
    if (!fresh) {
      forall e in [0..u-1] : best[e] = bestAt(e);
      fresh = true;
    }
  }

  // The unpicked set containing e with the largest coverage, lowest index
  // on ties; -1 when no unpicked set contains e.
  int bestAt(int e) {
    int win = 0 - 1;
    int s = 0;
    while (s < m) {
      if (S[s][e] == 1 && !G[s]) {
        if (win < 0) { win = s; } else { if (cnt[s] > cnt[win]) { win = s; } };
      };
      s = s + 1;
    };
    return win;
  }
}
