// LLP-WeightedSetCover: primal-dual f-approximation for weighted set
// cover, matching bxx-approximate.tex Algorithm LLP-WeightedSetCover
// (fig:llp-wsc). G[x] is the price on element x; a set s is tight when
// its incident prices saturate w(s); an element is slack when it lies
// in no tight set; slackMin(x) further requires x to be lex-minimal
// among every slack element sharing a set with it. Advancing raises
// x's price by the smallest remaining budget among the sets containing
// it, tightening at least one of them.
//
// The guard names its own range, `x in [0..u-1]`, because x ranges over
// ELEMENTS while the bound the compiler would otherwise infer comes from
// the first 1D array parameter (w.length, the number of SETS) -- a
// different count whenever sets and elements aren't equinumerous.
//
// S, w and G are program fields, so the aux methods read them directly
// rather than taking them as parameters; each predicate is the quantifier it
// is defined as, and each reduction names its own range with `where`.

class LLPWeightedSetCover {
  boolean[] LLPWeightedSetCover(int[][] S, double[] w) {
    int m = w.length;
    int u = S[0].length;
    double[] G = new double[u];
    forbidden (x in [0..u-1]) : slackMin(x) =>
      advance : { G[x] = G[x] + minRemainingBudget(x); };
    boolean[] C = new boolean[m];
    forall s in [0..m-1] : C[s] = setTight(s);
    return C;
  }

  // Sum of the prices on the elements of s.
  double setPrice(int s) {
    return sum e in [0..u-1] where S[s][e] == 1 : G[e];
  }

  boolean setTight(int s) {
    return setPrice(s) >= w[s];
  }

  // e lies in no tight set.
  boolean isSlack(int e) {
    return !(exists s in [0..m-1] : (S[s][e] == 1 && setTight(s)));
  }

  // Smallest remaining budget among the sets containing element e.
  double minRemainingBudget(int e) {
    return min s in [0..m-1] where S[s][e] == 1 : w[s] - setPrice(s);
  }

  // x is slack and lex-minimal among the slack elements sharing a set
  // with it -- i.e. no slack element below x shares a set with x.
  boolean slackMin(int x) {
    return isSlack(x)
        && !(exists y in [0..x-1] : (isSlack(y) && shareSet(x, y)));
  }

  // x and y both belong to some common set.
  boolean shareSet(int x, int y) {
    return exists s in [0..m-1] : (S[s][x] == 1 && S[s][y] == 1);
  }
}
