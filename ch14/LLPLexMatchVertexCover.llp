// LLP parallel 2-approximation for Vertex Cover: pick every endpoint of a lex-minimal uncovered edge.
//
// Edges are ordered by (min(u,v), max(u,v)), and the lex-least uncovered edge
// incident to a vertex u is always {u, minNbr(u)}, where minNbr(u) is u's
// smallest uncovered neighbour: a neighbour y < u contributes the key (y, u)
// and a neighbour y > u the key (u, y), so in both cases the smallest index
// wins. An edge is therefore lex-minimal among the edges touching it exactly
// when it is the lex-least edge at BOTH of its endpoints, which is what
// isLexMin below tests with two O(n) scans. Testing it directly -- "no smaller
// uncovered edge touches i or j" -- costs an O(n^2) scan over all edge pairs
// per candidate, so the predicate alone dominated the whole run.

class LLPLexMatchVertexCover {
  boolean[] LLPLexMatchVertexCover(int[][] adj) {
    // n must be bound explicitly: the compiler infers it from the first 1D
    // array parameter, and this program's only parameter is 2D. Without this
    // the field stays 0, G comes out empty and the fixpoint never runs -- the
    // program silently returned an empty cover for every input.
    int n = adj.length;
    boolean[] G = false;
    forbidden (j) : isLexMin(j) =>
      advance : {
        // Cover BOTH endpoints of the selected edge. Marking only j would
        // leave its partner i uncovered, and i's own test then sees a
        // different minNbr and fails -- the selected edges stop being a
        // matching and the 2-approximation bound is lost (on a 4-leaf star
        // the cover came out as 3 vertices against an optimum of 1).
        int i = minNbr(j);
        G[j] = true;
        G[i] = true;
      };
    return G;
  }

  // j is an endpoint of the lex-minimal uncovered edge {j, i}: i is j's
  // smallest uncovered neighbour and j is i's.
  boolean isLexMin(int j) {
    if (G[j]) { return false; };
    int i = minNbr(j);
    if (i < 0) { return false; };
    return minNbr(i) == j;
  }

  // The smallest uncovered neighbour of u, or -1 when u has none.
  int minNbr(int u) {
    int y = 0;
    while (y < n) {
      if (adj[u][y] == 1 && !G[y]) { return y; };
      y = y + 1;
    };
    return 0 - 1;
  }
}
