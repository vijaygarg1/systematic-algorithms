// Reachability as a 1-bit LLP: forbidden = unreached vertex with reached predecessor.

class LLPTraversal {
  boolean[] LLPTraversal(set<int>[] pre) {
    boolean[] G = false;
    G[0] = true;
    forbidden (j in [0..n-1]) : !G[j] && (exists i in pre[j] : G[i]) =>
      advance : G[j] = true;
    return G;
  }
}
