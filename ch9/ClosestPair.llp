// Classical divide-and-conquer closest pair of points.
//
// Px and Py hold the coordinates, indexed by point number, with the points
// numbered in increasing x order. Ys lists this subproblem's point numbers
// in increasing y order, which is what lets the strip scan stop after a
// constant number of neighbours. G is the running answer: G[0] the best
// SQUARED distance (squared, so no sqrt is ever needed), G[1] and G[2] the
// two points achieving it.

class ClosestPair {
  double[] find(int lo, int hi, double[] Px, double[] Py, int[] Ys) {
    double[] G = new double[3];
    G[0] = infinity; G[1] = 0 - 1; G[2] = 0 - 1;
    ClosestPair(lo, hi, Px, Py, Ys, G);
    return G;
  }

  void ClosestPair(int lo, int hi, double[] Px, double[] Py, int[] Ys, double[] G) {
    if (hi <= lo) { return; };
    // Three points or fewer: compare every pair and stop recursing.
    if (hi - lo <= 2) {
      forall i in [lo..hi - 1] : {
        int j = i + 1;
        while (j <= hi) { check(i, j, Px, Py, G); j = j + 1; };
      };
      return;
    };
    int mid = (lo + hi) / 2;
    double midX = Px[mid];
    int n = hi - lo + 1;

    // Split this subproblem's point numbers around the midpoint. Walking Ys
    // in order means each side comes out in y order too, which the strip
    // scan below relies on.
    int[] Ls = new int[n];
    int[] Rs = new int[n];
    int nl = 0;
    int nr = 0;
    int k = 0;
    while (k < n) {
      int p = Ys[k];
      if (p <= mid) {
        Ls[nl] = p;
        nl = nl + 1;
      } else {
        Rs[nr] = p;
        nr = nr + 1;
      };
      k = k + 1;
    };
    ClosestPair(lo, mid, Px, Py, Ls, G);
    ClosestPair(mid + 1, hi, Px, Py, Rs, G);

    // The strip: points whose x is within the current best distance of the
    // dividing line. Comparing squared x-gaps against G[0] keeps it exact.
    int[] strip = new int[n];
    int m = 0;
    k = 0;
    while (k < n) {
      int p = Ys[k];
      double dx = Px[p] - midX;
      if (dx * dx < G[0]) {
        strip[m] = p;
        m = m + 1;
      };
      k = k + 1;
    };

    forall a in [0..m-1] : {
      int b = a + 1;
      int limit = a + 15;
      while (b < m && b <= limit) { check(strip[a], strip[b], Px, Py, G); b = b + 1; };
    }
  }

  // Record the pair (i, j) if it beats the best squared distance so far.
  void check(int i, int j, double[] Px, double[] Py, double[] G) {
    double dx = Px[i] - Px[j];
    double dy = Py[i] - Py[j];
    double d = dx * dx + dy * dy;
    if (d < G[0]) { G[0] = d; G[1] = i; G[2] = j; }
  }
}
