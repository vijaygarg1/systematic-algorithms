// Strassen's matrix multiplication: 7 recursive products instead of 8.
//
// Matches bxx-divideConquer.tex Algorithm Strassen (algo:strassen),
// including its infix matrix arithmetic -- the book writes
// Strassen(A11 + A22, B11 + B22) and C11 := M1 + M4 - M5 + M7, so this
// does too rather than nesting add()/sub() calls.
//
// Pseudocode, not compilable LL: matrix-valued + and -, the multiple
// assignment from split(), and Matrix itself have no LL counterpart.
// Listed in EXPECTED_UNSUPPORTED in sync-code-from-lang.py alongside
// ConvexHull and FFT for that reason. The recursive calls carry n / 2
// explicitly where the book leaves the size implicit in "Each
// n/2 x n/2"; the base case is 0-indexed here against the book's
// C[1,1] := A[1,1] . B[1,1].

Matrix strassen(Matrix A, Matrix B, int n) {
  if (n == 1) {
    return matrix(A[0][0] * B[0][0]);
  };
  Matrix A11, A12, A21, A22 = split(A, n);
  Matrix B11, B12, B21, B22 = split(B, n);
  Matrix M1 = strassen(A11 + A22, B11 + B22, n / 2);
  Matrix M2 = strassen(A21 + A22, B11, n / 2);
  Matrix M3 = strassen(A11, B12 - B22, n / 2);
  Matrix M4 = strassen(A22, B21 - B11, n / 2);
  Matrix M5 = strassen(A11 + A12, B22, n / 2);
  Matrix M6 = strassen(A21 - A11, B11 + B12, n / 2);
  Matrix M7 = strassen(A12 - A22, B21 + B22, n / 2);
  Matrix C11 = M1 + M4 - M5 + M7;
  Matrix C12 = M3 + M5;
  Matrix C21 = M2 + M4;
  Matrix C22 = M1 - M2 + M3 + M6;
  return combine(C11, C12, C21, C22);
}
