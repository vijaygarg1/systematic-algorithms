// Classical Bellman-Ford: n-1 relaxation passes over every edge.

class BellmanFord {
  int[] shortestPath(int n, int[] U, int[] V, int[] W, int s) {
    int[] dist = new int[n];
    forall i in [0..n-1] : dist[i] = infinity;
    dist[s] = 0;
    int k = 1;
    while (k < n) {
      int e = 0;
      while (e < U.length) {
        int u = U[e];
        int v = V[e];
        if (dist[u] != infinity && dist[u] + W[e] < dist[v]) {
          dist[v] = dist[u] + W[e];
        };
        e = e + 1;
      };
      k = k + 1;
    };
    return dist;
  }
}
