// LLP-Knapsack: the book's two rules over the (i, c) lattice, joined by
// `&&` so they share one fixpoint, with each index carrying its own
// bound -- i over items, c over capacities.

class LLPKnapsack {
  int[][] LLPKnapsack(int[] w, int[] v, int W) {
    int n = w.length - 1;
    int[][] G = new int[n + 1][W + 1];
    forbidden (i in [1..n], c in [1..W]) : G[i][c] < G[i-1][c] =>
      advance : { G[i][c] = G[i-1][c]; }
    &&
    forbidden (i in [1..n], c in [1..W]) : w[i] <= c && G[i][c] < G[i-1][c-w[i]] + v[i] =>
      advance : { G[i][c] = G[i-1][c-w[i]] + v[i]; };
    return G;
  }
}
