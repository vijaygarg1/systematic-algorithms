// Classical O(n²) LIS DP.

class LIS {
  int[] solve(int[] A) {
    int n = A.length;
    int[] G = new int[n];
    forall i in [0..n-1] : G[i] = 1;
    forall i in [1..n-1] :
      forall j in [0..i-1] :
        if (A[j] < A[i]) {
          G[i] = max(G[i], G[j] + 1);
        };
    return G;
  }
}
