// Maximum-cardinality interval scheduling: greedy by earliest finish time.

class Interval {
  int[] schedule(int[] s, int[] f) {
    int n = s.length;
    int[] G = new int[n];
    if (n > 0) {
      G[0] = 1;
      int last = 0;
      forall i in [1..n-1] : {
        if (s[i] >= f[last]) {
          G[i] = 1;
          last = i;
        };
      }
    };
    return G;
  }
}
