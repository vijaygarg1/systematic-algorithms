// Classical FPTAS for 0/1 Knapsack: scale the profits down by
// mu = eps*M/nf, then solve the scaled problem exactly by a profit-indexed
// DP. Rounding loses at most eps*OPT, and the scaled profit range is
// O(nf^2/eps), so the whole thing is polynomial in nf and 1/eps.
//
// D[i][p] = least total weight of a subset of the first i feasible items
// whose scaled profit is at least p, with D[i][0] = 0 and every other
// cell starting at INF. The answer is the largest p with D[nf][p] <= W;
// the traceback then walks the rows back, taking item i exactly when
// including it is what made row i cheaper than row i-1.

class FPTASKnapsack {
  boolean[] FPTASKnapsack(int[] w, int[] v, int W, int epsNum, int epsDen) {
    boolean[] S = new boolean[w.length];

    // Items too heavy to fit alone can never be used; orig[0..nf-1] lists
    // the ones that can, as indices into the caller's arrays.
    int[] orig = new int[w.length];
    int nf = 0;
    forall t in [0..w.length-1] : {
      if (w[t] <= W) {
        orig[nf] = t;
        nf = nf + 1;
      };
    };
    if (nf == 0) { return S; };   // no item fits: empty solution

    int[] fw = new int[nf];
    int[] fv = new int[nf];
    int k = 0;
    while (k < nf) {
      fw[k] = w[orig[k]];
      fv[k] = v[orig[k]];
      k = k + 1;
    };

    // Scale every profit by mu = eps*M/nf, accumulating the scaled total Vp
    // (the DP's profit axis) and INF, one more than any reachable weight.
    int M = max j in [0..nf - 1] : fv[j];
    int[] vPrime = new int[nf];
    int Vp = 0;
    int INF = 1;
    k = 0;
    while (k < nf) {
      vPrime[k] = (fv[k] * nf * epsDen) / (epsNum * M);
      Vp = Vp + vPrime[k];
      INF = INF + fw[k];
      k = k + 1;
    };

    // D[a][0] stays 0 -- profit 0 needs no weight; every other cell starts
    // unreachable, then each row is filled from the row above it.
    int[][] D = new int[nf + 1][Vp + 1];
    forall a in [0..nf] : forall b in [1..Vp] : D[a][b] = INF;
    forall i in [1..nf] : forall p in [1..Vp] :
      D[i][p] = min(D[i - 1][p], fw[i - 1] + D[i - 1][max(0, p - vPrime[i - 1])]);

    // Best reachable scaled profit -- the last q whose least weight still
    // fits -- then walk the rows back to recover the items that achieved it.
    int bp = 0;
    forall q in [0..Vp] : {
      if (D[nf][q] <= W) { bp = q; };
    };
    int i = nf;
    while (i > 0) {
      if (D[i][bp] < D[i - 1][bp]) {
        S[orig[i - 1]] = true;
        bp = max(0, bp - vPrime[i - 1]);
      };
      i = i - 1;
    };
    return S;
  }
}
