// LLP housing market, matching bxx-housing.tex Algorithm
// LLP-Housing-Market-Algorithm. Houses are identified with agent
// indices (agent j initially owns house j). wish(i) is the house agent
// i currently proposes for. S(G), the largest submatching, is the set
// of agents lying on a cycle of the wish functional graph (i -> wish(i))

class LLPHousingMarket {
  int[] LLPHousingMarket(int[][] pref) {
    int n = pref.length;
    int[] G = new int[n];
    boolean[] inS = new boolean[n];
    int[] indeg = new int[n];
    int[] q = new int[n];
    boolean fresh = false;
    forall k in [0..n-1] : G[k] = 0;
    forbidden (j in [0..n-1]) : !inSubmatching(j, G, pref) && inSubmatching(wish(j, G, pref), G, pref) =>
      advance : {
        G[j] = G[j] + 1;
        fresh = false;
      };
    return G;
  }

  int wish(int i, int[] G, int[][] pref) {
    return pref[i][G[i]];
  }

  // True iff agent j lies on a cycle of the wish functional graph
  // (i -> wish(i)), i.e. j belongs to S(G), the largest submatching.
  boolean inSubmatching(int j, int[] G, int[][] pref) {
    refresh(G, pref);
    return inS[j];
  }

  // Rebuild S(G) once after a wish has moved. An agent nobody wishes for
  // cannot lie on a cycle; discarding it may leave its own wish with no
  // one wishing for it, so the discards cascade. What remains is exactly
  // the union of the cycles. Each agent enters the queue at most once,
  // so this is O(n) for the whole market.
  void refresh(int[] G, int[][] pref) {
    if (fresh) { return; };
    forall i in [0..n-1] : { inS[i] = true; indeg[i] = 0; };
    forall i in [0..n-1] : indeg[wish(i, G, pref)] = indeg[wish(i, G, pref)] + 1;
    int qt = 0;
    forall i in [0..n-1] : {
      if (indeg[i] == 0) { q[qt] = i; qt = qt + 1; };
    };
    int qh = 0;
    while (qh < qt) {
      int x = q[qh];
      qh = qh + 1;
      inS[x] = false;
      int y = wish(x, G, pref);
      indeg[y] = indeg[y] - 1;
      if (indeg[y] == 0) { q[qt] = y; qt = qt + 1; };
    };
    fresh = true;
  }
}
