// Parallel merge sort: recursive halves composed with `[ A [] B ]`.

class MergeSort {
  void MergeSort(int lo, int hi, int[] G) {
    if (lo < hi) {
      int mid = (lo + hi) / 2;
      [ MergeSort(lo, mid, G) [] MergeSort(mid+1, hi, G) ];
      Merge(lo, mid, hi, G);
    }
  }

  // Sequential aux: merge G[lo..mid] and G[mid+1..hi] in place using a
  // scratch copy B, sized to the sub-range. Allocating and copying the
  // whole array on every one of the Theta(n) merge calls would cost
  // Theta(n^2) by itself, swamping the O(n log n) the merging achieves.
  void Merge(int lo, int mid, int hi, int[] G) {
    int[] B = new int[hi - lo + 1];
    forall k in [lo..hi] : B[k - lo] = G[k];
    int i = lo;
    int j = mid + 1;
    int k = lo;
    while (i <= mid && j <= hi) {
      if (B[i - lo] <= B[j - lo]) {
        G[k] = B[i - lo];
        i = i + 1;
      } else {
        G[k] = B[j - lo];
        j = j + 1;
      };
      k = k + 1;
    };
    while (i <= mid) {
      G[k] = B[i - lo];
      i = i + 1;
      k = k + 1;
    };
    while (j <= hi) {
      G[k] = B[j - lo];
      j = j + 1;
      k = k + 1;
    }
  }
}
