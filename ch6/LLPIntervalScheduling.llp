// LLP-IntervalScheduling: G[j] = true when job j is selected; forbidden when j is unselected and compatible with every already-selected earlier job.

class LLPIntervalScheduling {
  boolean[] LLPIntervalScheduling(int[] s, int[] f) {
    boolean[] G = false;
    forbidden (j) :
      !G[j] && (forall i in [0..j-1] : !G[i] || f[i] <= s[j])
    =>
      advance : G[j] = true;
    return G;
  }
}
