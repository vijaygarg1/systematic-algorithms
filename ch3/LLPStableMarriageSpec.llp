// LLP-StableMarriage-Spec: specification form of Gale-Shapley (bxx-stableMatching.tex).
// G[j] = man j's current proposal index, 1 = top choice; I is its initial value, 1<=I[i]<=n.
// Guard restored 2026-10-26: without it a bad I runs G[j] to n+1 and reads past mpref's row.

class LLPStableMarriageSpec {
  int[] LLPStableMarriageSpec(int[0..n][0..n] mpref, int[0..n][0..n] rank, int[0..n] I) {
    setBase(1);
    int[0..n] G = 0;
    forall k in [1..n] : G[k] = I[k];
    always : int z = mpref[j][G[j]];
    forbidden (j in [1..n]) :
      exists i in [1..n] :
        exists k in [1..G[i]] :
          mpref[i][k] == z && rank[z][i] < rank[z][j]
    =>
      advance : {
        // forbidden on his last choice => no stable matching extends I
        if (G[j] == n) { return null; };
        G[j] = G[j] + 1;
      };
    return G;
  }
}
