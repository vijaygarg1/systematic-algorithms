// Classical sequential weighted-interval-scheduling DP. Intervals are
// presorted once by finish time, with index 0 a 0-weight sentinel, so
// p[j] -- the last interval that finishes no later than j starts -- is
// derived here rather than supplied: it is the largest such index, or the
// sentinel 0 when no earlier interval fits.

class WeightedIntervalScheduling {
  int[] schedule(int[] s, int[] f, int[] w) {
    requires forall j in [1..f.length-2] : f[j] <= f[j+1];
    int n = s.length;
    int[] p = new int[n];
    int[] G = new int[n];
    int[] sel   = new int[n];
    forall j in [1..n-1] : p[j] = lastCompatible(j, s, f);
    // Phase 1: compute optimal values.
    G[0] = 0;
    forall cur in [1..n-1] :
      G[cur] = max(w[cur] + G[p[cur]], G[cur - 1]);
    // Phase 2: backtrack to find selected intervals.
    int cur = n - 1;
    while (cur > 0) {
      if (w[cur] + G[p[cur]] >= G[cur - 1]) {
        sel[cur] = 1;
        cur = p[cur];
      } else {
        cur = cur - 1;
      }
    };
    return sel;
  }

  // The largest i < j whose interval finishes no later than j starts, or 0
  // when j overlaps every earlier interval.
  // Binary search, not a scan: the intervals are already sorted by finish
  // time, so the largest i < j with f[i] <= s[j] is found in O(log n).
  // Scanning [1..j-1] for every j made deriving p an O(n^2) step on its
  // own, against the O(n log n) the book states for it (Section 10.3,
  // "computing p takes O(n log n) by binary search on the sorted finish
  // times") -- and swamped the O(n) dynamic program it feeds.
  int lastCompatible(int j, int[] s, int[] f) {
    int lo = 1;
    int hi = j - 1;
    int best = 0;
    while (lo <= hi) {
      invariant lo >= 1 && hi <= j - 1;
      int mid = (lo + hi) / 2;
      if (f[mid] <= s[j]) { best = mid; lo = mid + 1; } else { hi = mid - 1; };
    };
    return best;
  }
}
