// LLP-IntervalPartition (bxx-greedy.tex, fig:intervalPartition): assign
// each course j to the least free room not used by any overlapping
// earlier course in pre[j]; advance fixes j once all of its pre-set is
// fixed. The least-free-room computation uses a min-heap keyed by the
// occupied room numbers in pre[j] (extract-min repeatedly to find the
// smallest room number not present), matching the book's heap-based
// advance step, not a linear re-scan of pre[j] for every candidate room
// number.

class LLPIntervalPartition {
  int[] LLPIntervalPartition(set<int>[] pre) {
    int[]      G     = 1;
    boolean[]  fixed = false;
    forbidden (j) :
      !fixed[j] && forall i in pre[j] : fixed[i]
    =>
      advance : {
        G[j] = leastFreeRoom(j);
        fixed[j] = true;
      };
    return G;
  }

  int leastFreeRoom(int j) {
    int k = pre[j].length;
    int[] heap = new int[k];
    int heapSize = 0;
    forall i in pre[j] : heapSize = heapPush(heap, heapSize, G[i]);
    int r = 1;
    while (heapSize > 0 && heap[0] == r) {
      heapSize = heapPop(heap, heapSize);
      r = r + 1;
    };
    return r;
  }

  int heapPush(int[] h, int size, int key) {
    int i = size;
    h[i] = key;
    size = size + 1;
    while (i > 0 && h[(i - 1) / 2] > h[i]) {
      int p = (i - 1) / 2;
      swap(h[i], h[p]);
      i = p;
    };
    return size;
  }

  int heapPop(int[] h, int size) {
    size = size - 1;
    h[0] = h[size];
    heapify(h, 0, size);
    return size;
  }

  void heapify(int[] h, int i, int size) {
    int smallest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;
    if (left < size && h[left] < h[smallest]) { smallest = left; };
    if (right < size && h[right] < h[smallest]) { smallest = right; };
    if (smallest != i) {
      swap(h[i], h[smallest]);
      heapify(h, smallest, size);
    }
  }
}
