// LLP job scheduling: forbidden when G[j] < max_{i in pre[j]} G[i] + t[j].

int[] LLPJobSchedulingForbidden(int[]       t, set<int>[]  pre) {
  int[]       G = 0;
  setAcyclic(pre);
  forall k in [0..n] : G[k] = t[k];
  forbidden (j in [0..n-1]) : G[j] < max i in pre[j] : G[i] + t[j] =>
    advance : G[j] = max i in pre[j] : G[i] + t[j];
  return G;
}
