// FPTAS for Knapsack: discard items that cannot fit, then scale profits by
// mu = eps*M/nf (M = max profit among feasible items) and run the standard 0/1 DP
// profit-indexed as D[i][p] = min weight to reach scaled profit >= p.  The table is
// O(nf * V') with V' = O(nf^2/eps).  Fully polynomial.
//
// The preprocessing is written with aggregate expressions -- filter, map, max,
// sum -- to mirror Algorithm FPTAS-Knapsack in the book, which states it in
// set-builder form: F := {i : w_i <= W}, M := max_{i in F} v_i, and
// v'_i := floor(v_i / scale) for every i in F.  `orig` is exactly F, and it
// carries the *original* item indices, which is what lets the backtrack map a
// selection in the scaled instance back to an item of the input.

class FPTASKnapsack {
  boolean[] FPTASKnapsack(int[] w, int[] v, int W, int epsNum, int epsDen) {
    boolean[] S  = new boolean[w.length];
    int[] orig   = filter t in [0..w.length - 1] : w[t] <= W;
    int   nf     = orig.length;
    if (nf == 0) { return S; };   // no item fits: empty solution
    int[] fw     = map k in [0..nf - 1] : w[orig[k]];
    int[] fv     = map k in [0..nf - 1] : v[orig[k]];
    int   M      = max k in [0..nf - 1] : fv[k];
    int[] vPrime = map k in [0..nf - 1] : (fv[k] * nf * epsDen) / (epsNum * M);
    int   Vp     = sum k in [0..nf - 1] : vPrime[k];
    int   INF    = 1 + sum k in [0..nf - 1] : fw[k];
    int[][] D    = initTable(nf, Vp, INF);
    // Standard forward DP over the profit axis: skip item i, or take it.
    int i = 1;
    while (i <= nf) {
      int p = 1;
      while (p <= Vp) {
        D[i][p] = min(D[i - 1][p], fw[i - 1] + D[i - 1][max(0, p - vPrime[i - 1])]);
        p = p + 1;
      };
      i = i + 1;
    };
    // p* = largest scaled profit achievable within capacity W.  Profit 0 is
    // always reachable (D[nf][0] = 0), so this set is never empty.
    int[] reach = filter q in [0..Vp] : D[nf][q] <= W;
    int bp = reach[reach.length - 1];
    // Backtrack over feasible items; map selections back to original indices.
    i = nf;
    while (i > 0) {
      if (D[i][bp] < D[i - 1][bp]) {
        S[orig[i - 1]] = true;
        bp = max(0, bp - vPrime[i - 1]);
      };
      i = i - 1;
    };
    return S;
  }

  // D[i][p] initialized to INF, except profit 0, which needs weight 0.
  int[][] initTable(int nf, int Vp, int INF) {
    int[][] D = new int[nf + 1][Vp + 1];
    int i = 0;
    while (i <= nf) {
      int p = 0;
      while (p <= Vp) {
        D[i][p] = INF;
        if (p == 0) { D[i][p] = 0; };
        p = p + 1;
      };
      i = i + 1;
    };
    return D;
  }
}
