// Classical Ford-Fulkerson maximum flow: repeatedly find an augmenting
// path in the residual graph by depth-first search and push the largest
// amount that fits along it, until no augmenting path remains.
//
// f is the flow matrix; residual(u, v) = c[u][v] - f[u][v] is the spare
// capacity of arc (u,v), and pushing b along (u,v) also subtracts b from
// f[v][u], which is what lets a later path cancel earlier flow.
// findAugmentingPath leaves the path in parent[], as a chain of
// predecessors running back from t to s.

class FordFulkerson {
  int[][] maxflow(int[][] c, int s, int t) {
    int n = c.length;
    int[][] f = new int[n][n];
    int[] parent = new int[n];
    while (findAugmentingPath(c, f, s, t, parent) == 1) {
      augment(f, s, t, parent, bottleneck(c, f, s, t, parent));
    };
    return f;
  }

  // Smallest residual capacity along the parent chain from v back to s.
  int bottleneck(int[][] c, int[][] f, int s, int v, int[] parent) {
    if (v == s) { return infinity; };
    return min(residual(c, f, parent[v], v), bottleneck(c, f, s, parent[v], parent));
  }

  // Push b units along that same chain, cancelling on the reverse arcs.
  void augment(int[][] f, int s, int v, int[] parent, int b) {
    if (v == s) { return; };
    int u = parent[v];
    f[u][v] = f[u][v] + b; f[v][u] = f[v][u] - b;
    augment(f, s, u, parent, b);
  }

  int findAugmentingPath(int[][] c, int[][] f, int s, int t, int[] parent) {
    boolean[] seen = new boolean[c.length];
    seen[s] = true; parent[s] = s;
    return dfs(c, f, s, t, parent, seen);
  }

  int dfs(int[][] c, int[][] f, int u, int t, int[] parent, boolean[] seen) {
    if (u == t) { return 1; };
    forall v in [0..c.length-1] : {
      if (!seen[v] && residual(c, f, u, v) > 0) {
        seen[v] = true; parent[v] = u;
        if (dfs(c, f, v, t, parent, seen) == 1) { return 1; };
      };
    };
    return 0;
  }

  int residual(int[][] c, int[][] f, int u, int v) { return c[u][v] - f[u][v]; }
}
