// LLP-Boruvka: Boruvka's minimum spanning tree with the component
// contraction done by LLP pointer jumping instead of recursion.
//
// Each round every active component finds its cheapest outgoing edge,
// points at the component on the other end, and then the guard below
// jumps those pointers until each chain collapses to one representative:
// forbidden when G[j] is not yet its own component's root, advance by
// following one more link. Mutual choices are broken by keeping the lower
// index as the root, which is what pointTo decides.
//
// A round that merges nothing means the graph is disconnected, which is
// what progress stops on.

class LLPBoruvka {
  boolean[] mst(int n, int[] U, int[] V, int[] W) {
    boolean[] T = new boolean[U.length], active = new boolean[n];
    int[] G = new int[n], mweEdge = new int[n];
    double[] mweW = new double[n];
    forall i in [0..n-1] : { G[i] = i; active[i] = true; };
    boolean progress = true;
    while (countActive() > 1 && progress) {
      int before = countActive();
      forall i in [0..n-1] : { mweEdge[i] = 0 - 1; mweW[i] = infinity; };

      // Cheapest edge leaving each still-active component.
      forall e in [0..U.length-1] : {
        int ru = find(U[e]), rv = find(V[e]);
        if (active[ru] && active[rv] && ru != rv) { relax(ru, e, W); relax(rv, e, W); };
      };

      forall i in [0..n-1] : if (active[i]) { G[i] = pointTo(i); };
      forbidden (j) : active[j] && G[j] != G[G[j]]  =>
        advance : G[j] = G[G[j]];
      forall i in [0..n-1] : if (active[i] && mweEdge[i] != 0 - 1) { T[mweEdge[i]] = true; };
      forall i in [0..n-1] : if (active[i] && G[i] != i) { active[i] = false; };
      progress = countActive() < before;
    };
    return T;
  }

  // Record e as the cheapest outgoing edge seen so far for component comp.
  void relax(int comp, int e, int[] W) {
    if (W[e] < mweW[comp]) { mweW[comp] = W[e]; mweEdge[comp] = e; }
  }

  // Which component i should point at: the one across its cheapest edge,
  // except that a mutual pair keeps the lower index as the root.
  int pointTo(int i) {
    if (mweEdge[i] == 0 - 1) { return i; };
    int w = otherEndpoint(mweEdge[i], i), wEdge = mweEdge[w];
    if (wEdge != 0 - 1 && otherEndpoint(wEdge, w) == i && i < w) { return i; };
    return w;
  }

  int find(int v) { while (G[v] != v) { v = G[v]; }; return v; }

  int countActive() { return count i in [0..n-1] : active[i]; }

  int otherEndpoint(int e, int v) { if (U[e] == v) { return V[e]; }; return U[e]; }
}
