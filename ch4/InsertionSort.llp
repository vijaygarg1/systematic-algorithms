// Insertion sort: walk each new element down to its place.

class InsertionSort {
  void sort(int[] A) {
    int i = 1;
    while (i < A.length) {
      int j = i - 1;
      boolean done = false;
      while (j >= 0 && !done) {
        if (A[j] <= A[j + 1]) {
          done = true;
        } else {
          swap(A[j], A[j + 1]);
          j = j - 1;
        }
      };
      i = i + 1;
    }
  }
}
